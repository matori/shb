{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "detail.schema.json",
  "title": "DetailResponse",
  "description": "GET /shb/v1/detail?url={URL} のレスポンス（200のとき）",
  "type": "object",
  "required": ["last_modified", "expires", "data"],
  "additionalProperties": false,
  "properties": {
    "last_modified": {
      "description": "データを取得した日時（ISO 8601、+09:00）",
      "type": "string",
      "format": "date-time"
    },
    "expires": {
      "description": "キャッシュの有効期限（ISO 8601、+09:00）",
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": ["floor", "entries", "error"],
      "additionalProperties": false,
      "properties": {
        "floor": {
          "description": "渡したURLが何階層目か。通常のURLは1、そのブックマークページは2、さらにそのブックマークページは3…。コメントページ（/entry/{eid}/comment/{user}）は1つ少なく数える",
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "description": "元のURLのエントリーから順に、ブックマークページ（メタブ）を上の階層へたどった結果。最大10件。1件目は必ずある",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/DetailEntry" }
        },
        "error": {
          "description": "途中で取得に失敗した場合は true（その場合 entries は途中までになる）",
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "DetailEntry": {
      "oneOf": [
        { "$ref": "#/$defs/DetailEntrySuccess" },
        { "$ref": "#/$defs/DetailEntryError" }
      ]
    },
    "DetailEntrySuccess": {
      "type": "object",
      "required": ["error", "status_code", "content"],
      "additionalProperties": false,
      "properties": {
        "error": { "type": "boolean", "const": false },
        "status_code": {
          "description": "はてなのHTTPステータスコード",
          "type": "integer"
        },
        "content": {
          "description": "はてなの /entry/json/ の結果。ブックマークされていないURLの場合は null（1件目のときだけ現れる）",
          "anyOf": [
            { "$ref": "#/$defs/HatenaEntry" },
            { "type": "null" }
          ]
        }
      }
    },
    "DetailEntryError": {
      "description": "取得に失敗した場合。1件目で失敗したときだけ entries に含まれる",
      "type": "object",
      "required": ["error", "status_code", "message", "content"],
      "additionalProperties": false,
      "properties": {
        "error": { "type": "boolean", "const": true },
        "status_code": {
          "description": "はてなのHTTPステータスコード。通信エラーの場合は0",
          "type": "integer"
        },
        "message": {
          "description": "エラーの内容（例: \"HTTP 503\", \"Couldn't connect to server\"）",
          "type": "string"
        },
        "content": { "type": "null" }
      }
    },
    "HatenaEntry": {
      "description": "はてなブックマークのエントリー情報（はてな側の仕様。項目が増えることがあるので additionalProperties は許可）",
      "type": "object",
      "required": ["eid", "title", "count", "url", "entry_url", "requested_url", "screenshot", "bookmarks", "related"],
      "additionalProperties": true,
      "properties": {
        "eid": {
          "description": "エントリーID（数字の文字列）",
          "type": "string"
        },
        "title": { "type": "string" },
        "count": {
          "description": "ブックマーク数",
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "description": "エントリーのURL",
          "type": "string"
        },
        "entry_url": {
          "description": "はてなブックマークのエントリーページのURL。次の階層はこのURLで取得している",
          "type": "string"
        },
        "requested_url": {
          "description": "はてなに問い合わせたURL",
          "type": "string"
        },
        "screenshot": {
          "description": "スクリーンショット画像のURL（ない場合ははてなの noimage 画像）",
          "type": "string"
        },
        "bookmarks": {
          "description": "公開されているブックマーク",
          "type": "array",
          "items": { "$ref": "#/$defs/HatenaBookmark" }
        },
        "related": {
          "description": "関連エントリー",
          "type": "array",
          "items": { "$ref": "#/$defs/HatenaRelatedEntry" }
        }
      }
    },
    "HatenaBookmark": {
      "type": "object",
      "required": ["user", "comment", "tags", "timestamp"],
      "additionalProperties": true,
      "properties": {
        "user": {
          "description": "はてなID",
          "type": "string"
        },
        "comment": {
          "description": "コメント。ない場合は空文字",
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timestamp": {
          "description": "ブックマークした日時（\"YYYY/MM/DD HH:mm\"、日本時間）",
          "type": "string",
          "pattern": "^\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}$"
        }
      }
    },
    "HatenaRelatedEntry": {
      "type": "object",
      "required": ["eid", "title", "count", "entry_url"],
      "additionalProperties": true,
      "properties": {
        "eid": { "type": "string" },
        "title": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "entry_url": { "type": "string" }
      }
    }
  }
}
